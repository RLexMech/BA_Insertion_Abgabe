# Both machines run Windows.
# The rule below is kept anyway: a .sh file is read by a POSIX shell
# (Git Bash, WSL), and those want LF. No .sh file is tracked today.
*.sh text eol=lf
# The evaluation tables: RowTable.from_csv hashes the RAW BYTES, and
# core.autocrlf is true on the laptop. -text = git never touches a line
# ending, so the SHA-256 is the same on both machines (eval_plan.md step A).
scripts/eval/*.csv -text

# Preserve the tested assets byte-for-byte, including their SHA256 checksums.
source/insertion/insertion/tasks/direct/insertion/assets/** -text
